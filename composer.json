{
    "name": "kissplugins/woo-coupon-debugger",
    "description": "A companion plugin for WooCommerce Smart Coupons to debug coupon application and hook/filter processing",
    "type": "wordpress-plugin",
    "license": "GPL-3.0+",
    "authors": [
        {
            "name": "KISS Plugins",
            "email": "devops@kissplugins.com",
            "homepage": "https://kissplugins.com"
        }
    ],
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "phpstan/phpstan": "^1.0",
        "squizlabs/php_codesniffer": "^3.6",
        "phpmd/phpmd": "^2.10",
        "wp-coding-standards/wpcs": "^3.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "KissPlugins\\WooCouponDebugger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KissPlugins\\WooCouponDebugger\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse src kiss-coupon-debugger.php --level=8 --configuration=phpstan.neon",
        "phpcs": "phpcs --standard=phpcs.xml.dist",
        "phpcbf": "phpcbf --standard=phpcs.xml.dist",
        "phpcs-summary": "phpcs --standard=phpcs.xml.dist --report=summary",
        "php-compat": "phpcs --standard=PHPCompatibility --runtime-set testVersion 8.0- src/ kiss-coupon-debugger.php",
        "lint": "find . -name '*.php' -not -path './vendor/*' -not -path './node_modules/*' | xargs php -l",
        "phpmd": "phpmd src text cleancode,codesize,controversial,design,naming,unusedcode",
        "test-all": [
            "@lint",
            "@phpcs",
            "@php-compat",
            "@phpstan"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
